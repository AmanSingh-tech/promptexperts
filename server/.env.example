DATABASE_URL="postgresql://ailogracer:ailogracer@localhost:5435/ailogracer"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRY="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Claude. The SDK also accepts ANTHROPIC_API_KEY / an `ant auth login` profile.
# ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-opus-5-5"
MAX_MESSAGES_PER_SESSION=60

# Code judge: "docker" (sandboxed, recommended) or "local" (runs code on the host; dev only)
JUDGE_MODE="docker"
SANDBOX_IMAGE="ailogracer-sandbox"
