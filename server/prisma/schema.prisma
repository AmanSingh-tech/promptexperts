generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  REVIEWER
  ADMIN
}

enum ProblemType {
  CODE
  WRITTEN
}

enum Category {
  ALGORITHMS
  DATA_STRUCTURES
  SYSTEM_DESIGN
  WEB_DEV
  DEBUGGING
  OTHER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SessionStatus {
  ACTIVE
  SUBMITTED
  ABANDONED
}

enum LogRole {
  USER
  ASSISTANT
}

enum LogSource {
  PLATFORM
  IMPORTED
}

enum SessionEventType {
  RUN
  SUBMIT
  PASTE
}

enum EvaluationStatus {
  PENDING
  DISPUTED
  FINAL
}

enum SolveStatus {
  ACCEPTED
  WRONG_ANSWER
  COMPILE_ERROR
  RUNTIME_ERROR
  TIME_LIMIT
  MANUAL_REVIEW
  JUDGE_ERROR
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  password    String
  firstName   String   @default("")
  lastName    String   @default("")
  role        Role     @default(USER)
  tokenVersion Int     @default(0)
  progressSeen Json?    @default("{\"totalPoints\":0,\"rank\":null,\"avgFinalScore\":0,\"evaluated\":0,\"achievements\":[]}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  solves      Solve[]
  aiSessions  AISession[]
  reviews     Evaluation[] @relation("Reviewer")
  reviewEntries Review[]
  problems    Problem[]    @relation("ProblemAuthor")
  resetTokens PasswordResetToken[]
  contestEntries ContestEntry[]
  achievements Achievement[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Problem {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String      @db.Text
  difficulty  Difficulty  @default(EASY)
  category    Category    @default(ALGORITHMS)
  type        ProblemType @default(CODE)
  constraints String?     @db.Text
  starterCode Json?
  timeLimitMs Int         @default(2000)
  published   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  authorId    String?

  author      User?       @relation("ProblemAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  testCases   TestCase[]
  solves      Solve[]
  aiSessions  AISession[]
  tags        ProblemTag[]
  contests    ContestProblem[]
  dailyChallenges DailyChallenge[]
}

model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  input          String  @db.Text
  expectedOutput String  @db.Text
  isSample       Boolean @default(false)
  position       Int     @default(0)

  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  problems ProblemTag[]
}

model ProblemTag {
  problemId String
  tagId     String

  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
}

model AISession {
  id            String        @id @default(cuid())
  userId        String
  problemId     String
  status        SessionStatus @default(ACTIVE)
  totalMessages Int           @default(0)
  inputTokens   Int           @default(0)
  outputTokens  Int           @default(0)
  runCount      Int           @default(0)
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem       Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  logs          AILog[]
  events        SessionEvent[]
  solve         Solve?

  @@index([userId, problemId, status])
}

model AILog {
  id         String    @id @default(cuid())
  sessionId  String
  role       LogRole
  content    String    @db.Text
  source     LogSource @default(PLATFORM)
  tool       String?
  tokensUsed Int?
  timestamp  DateTime  @default(now())

  session    AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

model SessionEvent {
  id        String           @id @default(cuid())
  sessionId String
  type      SessionEventType
  language  String?
  code      String?          @db.Text
  verdict   String?
  lines     Int?
  chars     Int?
  createdAt DateTime         @default(now())

  session   AISession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Solve {
  id          String      @id @default(cuid())
  userId      String
  problemId   String
  aiSessionId String?     @unique
  contestId   String?
  language    String
  code        String      @db.Text
  status      SolveStatus
  passedCount Int         @default(0)
  totalCount  Int         @default(0)
  autoScore   Int?
  results     Json?
  autoReview  Json?
  submittedAt DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  aiSession   AISession?  @relation(fields: [aiSessionId], references: [id], onDelete: SetNull)
  contest     Contest?    @relation(fields: [contestId], references: [id], onDelete: SetNull)
  evaluation  Evaluation?
  reviews     Review[]

  @@index([userId])
  @@index([problemId])
  @@index([contestId])
}

model Contest {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String           @db.Text
  startsAt    DateTime
  endsAt      DateTime
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  problems    ContestProblem[]
  entries     ContestEntry[]
  solves      Solve[]

  @@index([startsAt, endsAt])
}

model ContestProblem {
  contestId String
  problemId String
  position  Int     @default(0)

  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([contestId, problemId])
}

model ContestEntry {
  contestId String
  userId    String
  joinedAt  DateTime @default(now())

  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contestId, userId])
}

// Once earned, an achievement stays even if a later re-review lowers the score behind it.
model Achievement {
  userId   String
  key      String
  earnedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

// One featured challenge per UTC day. date is YYYY-MM-DD.
model DailyChallenge {
  date      String  @id
  problemId String

  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model Evaluation {
  id             String   @id @default(cuid())
  solveId        String   @unique
  reviewerId     String
  solutionScore  Int
  aiEfficiency   Int
  aiLearning     Int
  aiTransparency Int
  aiInnovation   Int
  aiUsageScore   Int
  finalScore     Int
  notes          String?  @db.Text
  status         EvaluationStatus @default(FINAL)
  reviewCount    Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  solve          Solve    @relation(fields: [solveId], references: [id], onDelete: Cascade)
  reviewer       User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([status])
}

// One reviewer's scores. Evaluation holds the combined result of all reviews for a submission.
model Review {
  id             String   @id @default(cuid())
  solveId        String
  reviewerId     String
  solutionScore  Int?
  aiEfficiency   Int
  aiLearning     Int
  aiTransparency Int
  aiInnovation   Int
  notes          String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  solve          Solve    @relation(fields: [solveId], references: [id], onDelete: Cascade)
  reviewer       User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([solveId, reviewerId])
}

// Shared by every API instance. Keys are "<limiter>:<subject>".
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// One running judge job. A lease stops being renewed if its API instance dies, so it frees itself.
model JudgeLease {
  userId    String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// A named ranking window. XP and levels are lifetime; a season only filters the leaderboard.
model Season {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([startsAt])
}
